// Prisma Schema for Electropathy AI
// Database: PostgreSQL on Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------
// 1. User & Authentication Models
// ---------------------------------------------

model User {
  id             String          @id @default(uuid())
  mobileNumber   String          @unique
  fullName       String?
  email          String?
  passwordHash   String?         // Used for Admin credentials
  userType       String?         // 'patient', 'practitioner', 'student', 'researcher'
  preferredLang  String          @default("en") // 'en', 'hi', 'mr'
  role           String          @default("patient") // 'patient', 'practitioner', 'admin'
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  refreshTokens  RefreshToken[]
  patientCases   PatientCase[]
  conversations  Conversation[]
  auditLogs      AuditLog[]
  patientProfile PatientProfile?

  @@map("users")
}

model OtpVerification {
  id           String    @id @default(uuid())
  mobileNumber String
  otpHash      String
  attempts     Int       @default(0)
  expiresAt    DateTime
  isUsed       Boolean   @default(false)
  lastSentAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([mobileNumber])
  @@map("otp_verifications")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

// ---------------------------------------------
// 2. Patient Case & Intake Models
// ---------------------------------------------

model PatientCase {
  id                  String             @id @default(uuid())
  practitionerId      String
  practitioner        User               @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  patientName         String
  age                 Int
  gender              String             // 'male', 'female', 'other'
  contactNumber       String
  city                String?
  occupation          String?
  chiefComplaints     Json               // [{complaint, duration, severity, factors}]
  presentIllness      Json               // {description, previousTreatments, responseToTreatment}
  pastMedical         Json               // {chronicConditions[], surgeries, allergies[]}
  lifestyle           Json               // {diet, sleep, appetite, stressLevel}
  electropathyDetails Json?              // {temperament, previousElectropathy, notes}
  status              String             @default("submitted") // 'draft', 'submitted', 'in_review', 'completed'
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  documents           PatientDocument[]

  @@index([practitionerId, createdAt(sort: Desc)])
  @@index([status])
  @@map("patient_cases")
}

model PatientDocument {
  id          String       @id @default(uuid())
  caseId      String
  patientCase PatientCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String?
  fileUrl     String
  fileSize    Int?
  uploadedAt  DateTime     @default(now())

  @@index([caseId])
  @@map("patient_documents")
}

// ---------------------------------------------
// 3. Conversational AI & Chat History Models
// ---------------------------------------------

model Conversation {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  language   String     @default("en")
  isDeleted  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  messages   Message[]

  @@index([userId, isDeleted, updatedAt(sort: Desc)])
  @@index([isDeleted, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // 'user', 'assistant', 'system'
  content        String
  feedback       String?      // 'helpful', 'not_helpful'
  metadata       Json?        // {model, tokens, latencyMs}
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("messages")
}

// ---------------------------------------------
// 4. Knowledge Base & RAG Engine Models
// ---------------------------------------------

model KnowledgeDocument {
  id           String            @id @default(uuid())
  fileName     String
  fileType     String?
  fileUrl      String?
  status       String            @default("uploaded") // 'uploaded', 'processing', 'parsed', 'approved', 'rejected'
  totalChunks  Int               @default(0)
  createdAt    DateTime          @default(now())
  chunks       KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id          String             @id @default(uuid())
  documentId  String
  document    KnowledgeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content     String
  category    String?            // 'Diseases', 'Symptoms', 'Medicines', 'Dosage', etc.
  language    String             @default("en")
  pageNumber  Int?
  chunkIndex  Int?
  metadata    Json?
  isApproved  Boolean            @default(false)
  isEnabled   Boolean            @default(true)
  createdAt   DateTime           @default(now())

  @@index([documentId])
  @@index([category, isApproved, isEnabled])
  @@map("knowledge_chunks")
}

// ---------------------------------------------
// 5. Audit Logging for Administrative Actions
// ---------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // 'ADMIN_LOGIN', 'VIEW_USER', 'UPDATE_USER_STATUS', 'VIEW_CONVERSATION', 'VIEW_PATIENT_CASE'
  targetId   String?  // Target resource ID
  details    Json?    // Contextual information
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------
// 6. v2026 Dual-Table Engine & Registries (Stage 1)
// ---------------------------------------------

model RemedyIdentity {
  id               String              @id @default(uuid())
  canonicalCode    String              @unique // S1, S2, C4, RE, BE, APP, etc.
  canonicalName    String
  remedyGroup      String              // Scrofoloso, Canceroso, etc.
  compoundType     String              @default("original") // 'original', 'compound', 'auxiliary', 'electricity'
  identityStatus   String              @default("verified_core") // 'verified_core', 'supplementary_unmatched'
  identityEvidence String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  coreRecord       CoreRemedyState?
  organRecords     OrganActionRecord[]
  mappings         RemedyMapping[]

  @@map("remedy_identities")
}

model SourceRegistry {
  id               String              @id @default(uuid())
  sourceCode       String              @unique // 'SRC-MATTEI-CORE-2026', 'SRC-AJIT-SPG-PDF-2026'
  title            String
  sourceType       String              // 'master_table_excel', 'scanned_pdf', 'clinical_protocol'
  version          String
  originalCitation String
  extractionMethod String              // 'author_curated', 'ocr_transcribed'
  reviewStatus     String              // 'approved', 'transcribed_unvalidated'
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())

  coreRecords      CoreRemedyState[]
  organRecords     OrganActionRecord[]
  mappings         RemedyMapping[]

  @@map("source_registries")
}

model CoreRemedyState {
  id                         String         @id @default(uuid())
  remedyId                   String         @unique
  remedy                     RemedyIdentity @relation(fields: [remedyId], references: [id], onDelete: Cascade)
  officialCode               String
  officialName               String
  remedyGroup                String
  polarity                   String
  organAxis                  String
  tissueAffinity             String
  primarySphere              String
  secondarySphere            String
  dominantState              String
  secondaryStates            String
  corePhysiologicalRole      String
  functionalKeywords         String
  pathophysiologicalTarget   String
  physiologicalEffectSummary String
  suggestedProtocolRole      String
  preferredStage             String
  protocolPosition           String
  externalLocalUse           String?
  organPolarityLink          String?
  electroPhysiologicalEffect String?
  colorSymbolism             String?
  remarks                    String?
  validationStatus           String         @default("Verified")
  sourceId                   String
  source                     SourceRegistry @relation(fields: [sourceId], references: [id])
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@map("core_remedy_states")
}

model OrganActionRecord {
  id                    String          @id @default(uuid())
  remedyId              String?
  remedy                RemedyIdentity? @relation(fields: [remedyId], references: [id], onDelete: SetNull)
  sourceEntryNo         Int
  sourceRemedyCode      String
  sourceRemedyName      String
  sourceGroup           String
  sourceOrganActionText String
  pdfPage               Int
  identityStatus        String          // 'matched_core', 'supplementary_unmatched'
  mappingStatus         String
  reviewNotes           String?
  sourceId              String
  source                SourceRegistry  @relation(fields: [sourceId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("organ_action_records")
}

model RemedyMapping {
  id                 String         @id @default(uuid())
  remedyId           String
  remedy             RemedyIdentity @relation(fields: [remedyId], references: [id], onDelete: Cascade)
  mappingType        String         // 'remedy_to_state', 'remedy_to_organ', 'remedy_to_requirement'
  targetConceptId    String
  targetConceptName  String
  evidenceClass      String         // 'Class_I_Verified', 'Class_II_Historical_Source'
  confidenceScore    Float          @default(1.0)
  approvalStatus     String         // 'practitioner_approved', 'pending_review'
  mappingRationale   String
  sourceId           String
  source             SourceRegistry @relation(fields: [sourceId], references: [id])
  createdAt          DateTime       @default(now())

  @@map("remedy_mappings")
}

// ---------------------------------------------
// 7. AI-Powered Patient Profiling & Medical History
// ---------------------------------------------

model PatientProfile {
  id                 String                      @id @default(uuid())
  userId             String?                     @unique
  user               User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String                      @default("Anonymous Patient")
  dateOfBirth        DateTime?
  age                Int?
  gender             String?                     // 'male', 'female', 'other', 'unspecified'
  phone              String?
  email              String?
  location           String?
  consentStatus      String                      @default("consented") // 'consented', 'revoked', 'pending'
  profileStatus      String                      @default("active")    // 'active', 'needs_review', 'verified'
  completenessScore  Int                         @default(10)          // 0 - 100%
  primarySymptoms    String?                     // Comma-separated summary of chief complaints
  lastInteractionAt  DateTime                    @default(now())
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  symptoms           PatientSymptom[]
  medicalHistory     PatientMedicalHistory[]
  medications        PatientMedication[]
  allergies          PatientAllergy[]
  lifestyles         PatientLifestyle[]
  observations       PatientProfileObservation[]
  historyEvents      PatientProfileHistory[]

  @@index([fullName])
  @@index([profileStatus, updatedAt(sort: Desc)])
  @@map("patient_profiles")
}

model PatientSymptom {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptom              String
  description          String?
  severity             String?        // 'mild', 'moderate', 'severe'
  duration             String?        // '2 weeks', '3 days', etc.
  onsetDate            String?
  currentStatus        String         @default("active") // 'active', 'improving', 'resolved', 'worsened', 'recurred'
  originalLanguage     String?        @default("en")     // 'en', 'hi', 'mr'
  originalStatement    String?        // Exact patient statement
  sourceConversationId String?
  sourceMessageId      String?
  verificationStatus   String         @default("ai_extracted") // 'ai_extracted', 'patient_confirmed', 'practitioner_verified', 'needs_review', 'corrected'
  extractionConfidence Float          @default(0.85)
  recordedAt           DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId, currentStatus])
  @@map("patient_symptoms")
}

model PatientMedicalHistory {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition            String
  description          String?
  status               String         @default("historical") // 'current', 'historical', 'family_history', 'resolved'
  onsetDate            String?
  sourceConversationId String?
  sourceMessageId      String?
  originalStatement    String?
  verificationStatus   String         @default("ai_extracted") // 'ai_extracted', 'patient_confirmed', 'practitioner_verified', 'needs_review', 'corrected'
  extractionConfidence Float          @default(0.85)
  recordedAt           DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId, status])
  @@map("patient_medical_history")
}

model PatientMedication {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationName       String
  condition            String?
  dosage               String?
  frequency            String?
  duration             String?
  medicationStatus     String         @default("current") // 'current', 'previous', 'stopped', 'adverse_reaction'
  sideEffects          String?
  treatmentOutcome     String?
  sourceConversationId String?
  sourceMessageId      String?
  originalStatement    String?
  verificationStatus   String         @default("ai_extracted") // 'ai_extracted', 'patient_confirmed', 'practitioner_verified', 'needs_review', 'corrected'
  recordedAt           DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId, medicationStatus])
  @@map("patient_medications")
}

model PatientAllergy {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen             String
  reaction             String?
  severity             String?        // 'mild', 'moderate', 'severe', 'anaphylactic'
  sourceConversationId String?
  sourceMessageId      String?
  originalStatement    String?
  verificationStatus   String         @default("ai_extracted") // 'ai_extracted', 'patient_confirmed', 'practitioner_verified', 'needs_review', 'corrected'
  recordedAt           DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId])
  @@map("patient_allergies")
}

model PatientLifestyle {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diet                 String?        // 'vegetarian', 'non-vegetarian', 'vegan', etc.
  sleep                String?        // 'insomnia', '6 hours', etc.
  physicalActivity     String?        // 'sedentary', 'active', etc.
  substanceUse         String?        // 'tobacco', 'alcohol', 'none'
  stressFactors        String?
  sourceConversationId String?
  sourceMessageId      String?
  recordedAt           DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId])
  @@map("patient_lifestyles")
}

model PatientProfileObservation {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category             String         // 'personal', 'symptom', 'medication', 'history', 'lifestyle', 'inquiry'
  extractedInformation Json           // Full structured payload
  originalStatement    String         // Patient exact statement
  language             String         @default("en")
  sourceConversationId String
  sourceMessageId      String?
  confidence           Float          @default(0.85)
  verificationStatus   String         @default("ai_extracted") // 'ai_extracted', 'patient_confirmed', 'practitioner_verified', 'needs_review', 'corrected'
  verificationNote     String?
  verifiedBy           String?
  verifiedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId, category])
  @@index([patientId, verificationStatus])
  @@map("patient_profile_observations")
}

model PatientProfileHistory {
  id                   String         @id @default(uuid())
  patientId            String
  patient              PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  eventType            String         // 'PROFILE_CREATED', 'SYMPTOM_REPORTED', 'SYMPTOM_UPDATED', 'MEDICATION_STARTED', 'MEDICATION_STOPPED', 'HISTORY_DISCLOSED', 'ALLERGY_ADDED', 'MANUAL_CORRECTION', 'PRACTITIONER_VERIFIED'
  title                String
  description          String
  fieldName            String?
  previousValue        Json?
  updatedValue         Json?
  sourceConversationId String?
  sourceMessageId      String?
  createdAt            DateTime       @default(now())

  @@index([patientId, createdAt(sort: Desc)])
  @@map("patient_profile_history")
}
